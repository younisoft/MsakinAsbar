# Apache (HostGator) equivalent of vercel.json
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS and the bare domain (www -> msakinasbar.com)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://msakinasbar.com/$1 [R=301,L]

# /index.html and /folder/index.html -> clean URL
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

# Add trailing slash to folders (/services/worker-transport -> .../)
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/webp .webp
AddType image/svg+xml .svg
AddType font/otf .otf
AddType font/ttf .ttf
AddCharset utf-8 .html .css .js .xml .txt .webmanifest
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "^404\.html$">
Header set X-Robots-Tag "noindex"
</FilesMatch>
<FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|otf|ttf|pdf)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml image/svg+xml application/manifest+json
</IfModule>

# Keep development files private
<FilesMatch "^(SEO-NOTES\.md|vercel\.json|\.vercelignore|\.gitignore|\.gitattributes)$">
Require all denied
</FilesMatch>
RedirectMatch 404 ^/(scripts|tmp|output|generated_images|\.git)(/|$)
